"""Fetch pinned templ compilers and register execution-platform toolchains."""

load("//templ/private:toolchains_repo.bzl", "PLATFORMS", "toolchains_repo")
load("//templ/private:versions.bzl", "TOOL_VERSIONS")

def _templ_repo_impl(repository_ctx):
    platform = repository_ctx.attr.platform
    repository_ctx.download_and_extract(
        url = "https://github.com/a-h/templ/releases/download/v{}/templ_{}.tar.gz".format(
            repository_ctx.attr.templ_version,
            PLATFORMS[platform].archive_platform,
        ),
        sha256 = TOOL_VERSIONS[repository_ctx.attr.templ_version][platform],
    )
    binary = "templ.exe" if platform.startswith("windows_") else "templ"
    repository_ctx.file("BUILD.bazel", """# Generated by templ/repositories.bzl
load("@rules_templ//templ:toolchain.bzl", "templ_toolchain")

templ_toolchain(
    name = "templ_toolchain",
    target_tool = "{binary}",
    visibility = ["//visibility:public"],
)
""".format(binary = binary))

templ_repositories = repository_rule(
    implementation = _templ_repo_impl,
    doc = "Downloads a pinned templ release for one execution platform.",
    attrs = {
        "templ_version": attr.string(mandatory = True, values = TOOL_VERSIONS.keys()),
        "platform": attr.string(mandatory = True, values = PLATFORMS.keys()),
    },
)

def templ_register_toolchains(name, templ_version, register = True):
    """Creates repositories for the bundled platforms and optionally registers them.

    Args:
        name: Base name for generated repositories.
        templ_version: Pinned templ version, without the v prefix.
        register: Whether to register toolchains (False in module extensions).
    """
    for platform in PLATFORMS:
        templ_repositories(
            name = name + "_" + platform,
            platform = platform,
            templ_version = templ_version,
        )
    toolchains_repo(name = name + "_toolchains", user_repository_name = name)
    if register:
        native.register_toolchains("@%s_toolchains//:all" % name)
